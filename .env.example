# Agent Fleet local configuration. Copy to .env and change only what you need.
# Never put real credentials in this file. Local mode needs no API key.

# --- Persistence ---
# Default: data/agent_fleet.sqlite3 in this repository.
# AGENT_FLEET_DATABASE_URL=sqlite:///D:/Orchestrator/agent-fleet/data/agent_fleet.sqlite3
# AGENT_FLEET_DATA_DIR=D:/Orchestrator/agent-fleet/data

# --- REST API (keep it on 127.0.0.1: local mode has no authentication) ---
AGENT_FLEET_API_HOST=127.0.0.1
AGENT_FLEET_API_PORT=8420
AGENT_FLEET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENT_FLEET_LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_AGENT_FLEET_API_URL=http://127.0.0.1:8420

# --- Local runner ---
AGENT_FLEET_RUNNER_NAME=local-runner
AGENT_FLEET_RUNNER_POLL_SECONDS=2
AGENT_FLEET_RUNNER_LEASE_SECONDS=90
AGENT_FLEET_RUNNER_MAX_CONCURRENT_RUNS=1
AGENT_FLEET_RUN_TIMEOUT_SECONDS=1800
AGENT_FLEET_RUN_MAX_ATTEMPTS=2
AGENT_FLEET_MAX_CONCURRENT_AGENTS=4

# --- Claude Code runtime ---
# Leave empty to find `claude` on PATH. Set it to the claude executable if detection fails.
# AGENT_FLEET_CLAUDE_PATH=C:/Users/<you>/AppData/Roaming/npm/node_modules/@anthropic-ai/claude-code/bin/claude.exe
# Folders that runs may use as their workspace (separate several with ";").
# Runs without a workspace use an empty folder in data/workspaces.
# AGENT_FLEET_ALLOWED_WORKSPACE_ROOTS=D:/Projects;D:/Orchestrator
AGENT_FLEET_ALLOW_WEB_TOOLS=false
# Shell commands that "Workspace edit" runs may use without approval (comma separated permission patterns).
# Warning: test runners such as "pytest *" or "npm test *" run project code with your user rights.
# Add them only for workspaces you trust.
AGENT_FLEET_EDIT_BASH_ALLOWLIST=git status,git diff *,git log *
# false (default): the runner removes ANTHROPIC_API_KEY from Claude Code's environment so runs use your
# Claude subscription login. Set true only if you deliberately want API-key billing.
AGENT_FLEET_KEEP_API_KEY_ENV=false
# The local Claude Code connector is for local development only. It refuses to run when this is true.
AGENT_FLEET_COMMERCIAL_MODE=false
